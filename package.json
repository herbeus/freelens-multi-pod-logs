{
  "name": "@andrea-falco/freelens-multi-pod-logs",
  "description": "Multi pod and container logs for Freelens",
  "version": "2.1.0",
  "author": "Andrea Falco",
  "publisher": "Andrea Falco",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrea-falco/freelens-multi-pod-logs.git",
    "directory": "."
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "engines": {
    "node": ">=22.0.0",
    "freelens": "^2.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=development webpack --watch --config webpack.config.cjs",
    "build": "npm run clean && NODE_ENV=production webpack --config webpack.config.cjs",
    "clean": "rm -rf ./dist",
    "lint": "eslint",
    "test": "npm run lint",
    "typecheck": "tsc --noEmit -p ."
  },
  "files": [
    "dist/**/*"
  ],
  "devDependencies": {
    "@babel/preset-env": "^7.17.10",
    "@babel/preset-react": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "@freelensapp/extensions": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "mobx": "^7.0.0",
    "mobx-react": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.9.0",
    "webpack": "^5.100.0",
    "webpack-cli": "^6.0.0"
  },
  "keywords": [
    "freelens",
    "extension",
    "kubernetes",
    "multi",
    "pod",
    "container",
    "logs"
  ],
  "license": "MIT",
  "type": "module"
}
